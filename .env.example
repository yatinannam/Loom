# Copy to .env and fill in LLM_API_KEY. Every variable is optional except the key,
# which is required for ingestion and querying (read-only endpoints work without it).

# --- LLM provider (any OpenAI-compatible endpoint) ---
# Groq free tier (default). Get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
EXTRACTION_MODEL=llama-3.3-70b-versatile
ANSWER_MODEL=llama-3.1-8b-instant
QUERY_ENTITY_MODEL=llama-3.1-8b-instant
# Local alternative via Ollama (no key needed, set LLM_API_KEY to any non-empty value):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# EXTRACTION_MODEL=qwen2.5:3b
# ANSWER_MODEL=qwen2.5:3b
# QUERY_ENTITY_MODEL=qwen2.5:3b
LLM_MAX_RPM=25
LLM_MAX_RETRIES=5
LLM_TIMEOUT_S=60
LLM_CACHE=true
# Cost estimate per million tokens (0 on the free tier)
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0

# --- Embeddings ---
# all-MiniLM-L6-v2 uses ChromaDB's bundled ONNX model (CPU, no extra install).
# Any other name loads a sentence-transformers model (requires `uv sync --extra st`).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=loom-password

# --- Ingestion ---
MAX_UPLOAD_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
MAX_EVIDENCE_CHUNKS=6
VECTOR_MIN_SCORE=0.2
ENTITY_MIN_SCORE=0.5
MAX_SEED_ENTITIES=5
MAX_HOPS=3
MAX_NODE_DEGREE=50
MAX_PATHS=200
HOP_DECAY=0.85
PATH_MIN_SCORE=0.1
TOP_PATHS=8
RRF_K=60
VECTOR_WEIGHT=1.0
GRAPH_WEIGHT=1.0

# --- API ---
CORS_ORIGINS=http://localhost:3000
